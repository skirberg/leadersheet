{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Leadersheet primitives. Raw values only: the semantic files (light, dark and their high-contrast overrides) alias these, and code never uses them directly. Colours are OKLCH with an sRGB hex fallback; each step is named for its OKLCH lightness (paper.965 is L 96.5%), so the gap between two names is the lightness gap between them.",
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": { "colorSpace": "oklch", "components": [0, 0, 0], "hex": "#000000" }, "$description": "Ink." },
      "349": {
        "$value": { "colorSpace": "oklch", "components": [0.3485, 0, 0], "hex": "#3a3a3a" },
        "$description": "The ink button's pressed edge, light mode."
      },
      "475": { "$value": { "colorSpace": "oklch", "components": [0.4748, 0, 0], "hex": "#5c5c5c" }, "$description": "Secondary text: black at about 64%." },
      "686": {
        "$value": { "colorSpace": "oklch", "components": [0.6862, 0, 0], "hex": "#9a9a9a" },
        "$description": "The ink button's pressed edge, dark mode."
      },
      "919": { "$value": { "colorSpace": "oklch", "components": [0.9189, 0, 0], "hex": "#e4e4e4" }, "$description": "Hairline rules, Brilliant's #e4e4e4." },
      "1000": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0], "hex": "#ffffff" }, "$description": "White: cards, and type on ink." },
      "$description": "Achromatic, from ink to white."
    },
    "paper": {
      "930": { "$value": { "colorSpace": "oklch", "components": [0.9302, 0.004, 106.48], "hex": "#e8e8e5" }, "$description": "Hover fill." },
      "935": {
        "$value": { "colorSpace": "oklch", "components": [0.9347, 0.0046, 78.3], "hex": "#ebe9e6" },
        "$description": "Muted fills: tracks, the picked choice, chips."
      },
      "964": { "$value": { "colorSpace": "oklch", "components": [0.9643, 0.007, 88.64], "hex": "#f5f3ee" }, "$description": "Ink on the night page." },
      "965": {
        "$value": { "colorSpace": "oklch", "components": [0.9651, 0.0034, 67.78], "hex": "#f5f3f1" },
        "$description": "The oat page, Brilliant's #f5f3f1."
      },
      "$description": "Warm off-whites: the oat page and its fills, and the warm white the dark theme writes in."
    },
    "slate": {
      "164": { "$value": { "colorSpace": "oklch", "components": [0.164, 0.0111, 268.01], "hex": "#0c0e13" }, "$description": "The night page." },
      "200": {
        "$value": { "colorSpace": "oklch", "components": [0.1998, 0.0129, 264.22], "hex": "#13161c" },
        "$description": "Ink on the pink and lime fills."
      },
      "204": { "$value": { "colorSpace": "oklch", "components": [0.2042, 0.0129, 264.23], "hex": "#14171d" }, "$description": "Cards at night." },
      "239": { "$value": { "colorSpace": "oklch", "components": [0.2393, 0.0142, 266.97], "hex": "#1c1f26" }, "$description": "Muted fills at night." },
      "268": { "$value": { "colorSpace": "oklch", "components": [0.2681, 0.016, 264.26], "hex": "#22262e" }, "$description": "Hover fill at night." },
      "301": { "$value": { "colorSpace": "oklch", "components": [0.3006, 0.0156, 264.31], "hex": "#2a2e36" }, "$description": "Hairlines at night." },
      "499": { "$value": { "colorSpace": "oklch", "components": [0.4993, 0.0151, 266.59], "hex": "#5f636c" }, "$description": "Control borders at night." },
      "527": {
        "$value": { "colorSpace": "oklch", "components": [0.5274, 0.0149, 266.6], "hex": "#676b74" },
        "$description": "Control borders at night: 3:1 on a card (the old #5f636c was 2.98)."
      },
      "600": { "$value": { "colorSpace": "oklch", "components": [0.6, 0.0126, 269.47], "hex": "#7d8088" }, "$description": "Control borders on paper." },
      "731": { "$value": { "colorSpace": "oklch", "components": [0.7305, 0.0111, 261.78], "hex": "#a4a8af" }, "$description": "Secondary text at night." },
      "807": {
        "$value": { "colorSpace": "oklch", "components": [0.8067, 0.0108, 261.79], "hex": "#bcc0c7" },
        "$description": "Secondary text at night, more contrast."
      },
      "$description": "Cool blue-greys: the night page, its cards and fills, and the control borders in both themes."
    },
    "pink": {
      "464": {
        "$value": { "colorSpace": "oklch", "components": [0.4642, 0.1887, 358.89], "hex": "#a30057" },
        "$description": "The signal as small text on paper, more contrast (7:1)."
      },
      "550": {
        "$value": { "colorSpace": "oklch", "components": [0.5504, 0.2204, 355.88], "hex": "#ca0d76" },
        "$description": "The signal as small text on paper."
      },
      "635": {
        "$value": { "colorSpace": "oklch", "components": [0.6345, 0.2447, 356.07], "hex": "#f1228f" },
        "$description": "The signal on paper: lines, data marks, focus, the logo fold."
      },
      "734": { "$value": { "colorSpace": "oklch", "components": [0.7336, 0.1859, 355.31], "hex": "#ff6fae" }, "$description": "The signal at night." },
      "786": {
        "$value": { "colorSpace": "oklch", "components": [0.786, 0.1534, 347.13], "hex": "#ff8ecc" },
        "$description": "The signal as small text at night, more contrast."
      },
      "$description": "The signal: hot pink, one thing per view, never an error."
    },
    "green": {
      "408": {
        "$value": { "colorSpace": "oklch", "components": [0.4078, 0.1181, 147.98], "hex": "#005a20" },
        "$description": "Ok on paper, more contrast: 7:1 on the page and in its own tint."
      },
      "499": { "$value": { "colorSpace": "oklch", "components": [0.4992, 0.13, 151.87], "hex": "#05773b" }, "$description": "Ok on paper." },
      "760": { "$value": { "colorSpace": "oklch", "components": [0.7604, 0.1506, 151.88], "hex": "#5bcc80" }, "$description": "Ok at night." },
      "$description": "Right and strong: the ok state."
    },
    "red": {
      "452": {
        "$value": { "colorSpace": "oklch", "components": [0.452, 0.1768, 19.63], "hex": "#a1092a" },
        "$description": "Destructive on paper, more contrast (7:1)."
      },
      "464": { "$value": { "colorSpace": "oklch", "components": [0.4639, 0.1764, 19.77], "hex": "#a5122d" }, "$description": "Destructive on paper." },
      "739": { "$value": { "colorSpace": "oklch", "components": [0.7393, 0.1625, 12.07], "hex": "#ff7a8f" }, "$description": "Destructive at night." },
      "782": {
        "$value": { "colorSpace": "oklch", "components": [0.7824, 0.1312, 8.67], "hex": "#ff93a7" },
        "$description": "Destructive at night, more contrast."
      },
      "$description": "Errors in forms only. Wrong answers are marked in ink, never red or pink."
    },
    "lime": {
      "920": { "$value": { "colorSpace": "oklch", "components": [0.9201, 0.2006, 120.13], "hex": "#d4f73e" }, "$description": "Lime at night." },
      "931": { "$value": { "colorSpace": "oklch", "components": [0.9308, 0.2004, 118.06], "hex": "#ddf93c" }, "$description": "Lime on paper." },
      "$description": "The second ink: one stroke of the win burst and the app icon."
    },
    "blue": {
      "675": { "$value": { "colorSpace": "oklch", "components": [0.6748, 0.1712, 270.2], "hex": "#6f8dff" }, "$description": "Card art blue." },
      "$description": "Illustration only: the home page's lesson cards."
    },
    "yellow": {
      "854": { "$value": { "colorSpace": "oklch", "components": [0.8536, 0.1459, 88.48], "hex": "#f6c94e" }, "$description": "Card art yellow." },
      "$description": "Illustration only: the home page's lesson cards."
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "Three speeds (DESIGN.md, Motion).",
    "press": { "$value": { "value": 120, "unit": "ms" }, "$description": "A control giving under a finger." },
    "ui": { "$value": { "value": 200, "unit": "ms" }, "$description": "Interface changes: colour, a panel, a page crossfade." },
    "draw": { "$value": { "value": 650, "unit": "ms" }, "$description": "A drawing moving: bars, markers, a line drawing itself." }
  },
  "easing": {
    "$type": "cubicBezier",
    "draft": { "$value": [0.2, 0.7, 0.2, 1], "$description": "Everything that moves: quick out, soft landing." },
    "snap": { "$value": [0.3, 1.4, 0.5, 1], "$description": "A small overshoot, for a mark landing." }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corners. Pills for controls, 14 px for choices, 28 px for large cards (Brilliant's measured system).",
    "base": { "$value": { "value": 8, "unit": "px" } },
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" }, "$description": "Choices and feedback banners." },
    "xl": { "$value": { "value": 20, "unit": "px" } },
    "2xl": { "$value": { "value": 28, "unit": "px" }, "$description": "Large cards." },
    "3xl": { "$value": { "value": 28, "unit": "px" } },
    "4xl": { "$value": { "value": 32, "unit": "px" } }
  },
  "layout": {
    "$description": "The page grid, measured from base-ui.com: equal columns, fixed gutters and margins, and every block's edges on a column line. One frame for every page, the header and the footer. It stops growing at 1200 px: twelve 78 px columns and eleven 24 px gutters.",
    "frame": { "$type": "dimension", "$value": { "value": 1200, "unit": "px" }, "$description": "The widest the grid gets, margins not included." },
    "compact": {
      "$description": "Phones, below 640 px.",
      "columns": { "$type": "number", "$value": 4 },
      "gutter": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "margin": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "section": { "$type": "dimension", "$value": { "value": 48, "unit": "px" }, "$description": "Between a page's sections, and above the first." }
    },
    "medium": {
      "$description": "From 640 px (Tailwind's sm).",
      "from": { "$type": "dimension", "$value": { "value": 640, "unit": "px" } },
      "columns": { "$type": "number", "$value": 8 },
      "gutter": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "margin": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "section": { "$type": "dimension", "$value": { "value": 56, "unit": "px" }, "$description": "Between a page's sections, and above the first." }
    },
    "expanded": {
      "$description": "From 1024 px (Tailwind's lg).",
      "from": { "$type": "dimension", "$value": { "value": 1024, "unit": "px" } },
      "columns": { "$type": "number", "$value": 12 },
      "gutter": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
      "margin": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
      "section": { "$type": "dimension", "$value": { "value": 64, "unit": "px" }, "$description": "Between a page's sections, and above the first." }
    }
  }
}
