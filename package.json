{
  "name": "leadersheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/brand-pack.ts",
    "dev": "next dev",
    "prebuild": "node scripts/brand-pack.ts",
    "build": "next build",
    "start": "next start",
    "qa": "node scripts/qa.ts",
    "smoke": "node scripts/smoke.ts",
    "shots": "node scripts/shots.ts",
    "og": "node scripts/make-og.ts",
    "icons": "node scripts/make-icons.ts",
    "brand": "node scripts/use-brand.ts",
    "brand:kit": "node scripts/make-icons.ts && npm run build && node scripts/make-og.ts && node scripts/make-brand-kit.ts && npm run build",
    "brand:check": "node scripts/brand-check.ts",
    "contrast": "node scripts/contrast.ts",
    "tokens": "node scripts/tokens.ts",
    "tokens:check": "node scripts/tokens.ts --check",
    "cases": "node scripts/cases.ts",
    "previews": "node scripts/previews.ts",
    "voice": "node scripts/voice.ts",
    "domains": "node scripts/domains.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --import ./scripts/test-hooks.ts --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run tokens:check && npm run contrast && npm test && npm run cases && npm run build && npm run og && npm run previews && npm run voice && npm run brand:check && npm run qa"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@number-flow/react": "^0.6.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.70.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.92.0",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
